node_modules/
# Remotion's own headless browser, downloaded on first render
.remotion/
__pycache__/
.DS_Store
# generated video projects (authored sources inside them are kept by each project's own .gitignore)
.visualize/*/public/
.visualize/*/.cache/
.visualize/*/out/
# a paper read in by `va paper`: somebody else's text and figures, fetched again when needed
.visualize/*/paper/
# papers and repos fetched as sources: somebody else's work, fetched again when needed
.visualize/papers/
.visualize/repos/
# render output, rewritten on every render
.visualize/*/render.log
